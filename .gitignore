# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# PEP 517 build çıktıları (pyproject'e [build-system] eklendi — `uv build` /
# `pip install -e .` bunları üretir). uv.lock BUNLARIN AKSİNE versiyonlanır.
build/
dist/

# Virtualenv
.venv/
venv/
env/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Secrets & local env
.env
.env.*

# Local caches produced at runtime
*.log
.nautilus_proxy_key

# Claude Code — personal permission settings (project settings.json is tracked)
.claude/settings.local.json

# Design source archives (extracted content lives in design_handoff_nautilus_lab/)
*.zip

# Local QQQ data downloads (198MB — not versioned)
data_downloads/

# Strategy Studio SQLite store — runtime artifact, recreated by scripts/seed_studio.py
studio.db
studio.db-wal
studio.db-shm

# Playwright scratch dir for scripts/check_auto_cockpit.py (screenshots + temp)
.pwtmp/

# Oturum içi geçici çalışma alanı: pytest scratch dizinleri (.tmp/pytest-*) ve
# araç raporu dökümleri (.tmp_deepr.json, .tmp_semgrep_report.json…). Koşumdan
# koşuma yeniden üretilirler; bazıları Windows ACL'i yüzünden okunamaz bile.
.tmp/
.tmp_*.json

# pytest çalışma dizini — içindeki .py'ler LLM'in test koşumunda ÜRETTİĞİ blok
# kodları (agnt_e_*/agnt_x_*); her koşumda yeniden yazılırlar (ruff'ta da dışlı).
work/

# LLM fine-tuning trainer cache — unrelated to this app, not versioned
unsloth_compiled_cache/

# Manual scratch/debug scripts (one-off fix scripts, browser-driven E2E probes)
debug/

# X (Twitter) izleyicisinin oturum çerezi. Varsayılanı `DATA_DIR` altındadır
# (repo dışı), ama NAU_DATA_DIR repo içine bakarsa bu dosya hesaba TAM ERİŞİM
# demektir — hiçbir koşulda versiyonlanmamalı.
x_storage_state.json
